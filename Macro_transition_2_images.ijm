title_1=getTitle();
waitForUser("select 2nd image, then OK");
title_2=getTitle(); 
Nsteps = 100;
setBatchMode("hide");
run("Images to Stack", "use keep");
rename("Variation_"+title_1);
run("Size...", "width="+getWidth+" height="+getHeight+" depth="+Nsteps+" interpolation=Bilinear");
close("Exception");
setBatchMode("exit and display");